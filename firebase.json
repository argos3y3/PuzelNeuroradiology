{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.py",
      "test-iframe.html",
      "**/*.rtf",
      "**/*.txt",
      "**/*.md",
      "**/*.pdf",
      "stato.json",
      "backup_*.json",
      "**/__pycache__/**",
      "img/immagini_recuperate/**",
      "img/nuove_immagini_recuperate/**",
      "img/screen-sito/**",
      "inserimento-esempio/**"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
