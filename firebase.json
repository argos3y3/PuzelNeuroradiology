{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      ".git/**",
      "**/.*/**",
      "**/node_modules/**",
      "**/__pycache__/**",
      "**/*.py",
      "**/*.rtf",
      "**/*.txt",
      "**/*.md",
      "**/*.pdf",
      "**/backup_*.json",
      "documenti/**",
      "outputs/**",
      "script/puzzel/**",
      "script/integrazione/**"
    ],
    "headers": [
      {
        "source": "catalogo.json",
        "headers": [
          { "key": "Access-Control-Allow-Origin", "value": "*" },
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "**/*.@(html|js|css)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
